{% extends "writing/layouts/base.njk" %}

{% block content %}
<div class="post-layout">
  <article class="post">
    <header class="post-header">
      <h1>{{ title }}</h1>
      <div class="post-meta">
        <time datetime="{{ date | dateISO }}">{{ date | dateFormat }}</time>
        {% if tags %}
        <div class="post-tags">
          {% for tag in tags %}
            {% if tag != "post" %}
              {% set tagUrl %}/writing/gene/{{ tag | tagSlug }}/{% endset %}
              <a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </header>
    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>
  <aside class="post-sidebar" aria-label="目录">{% if tocHeadings | length > 1 %}<nav class="toc" aria-label="目录"><p class="toc-title t-cat">目录</p><ol class="toc-list">{% for h in tocHeadings %}<li class="toc-item{% if h.level == 3 %} toc-sub{% endif %}"><a href="#{{ h.id }}">{{ h.text | safe }}</a></li>{% endfor %}</ol></nav>{% endif %}</aside>
</div>
<script src="/assets/js/writing/toc-highlight.js" defer></script>
<script src="/assets/js/writing/footnote-preview.js" defer></script>
<script src="/assets/js/writing/tabs.js" defer></script>
<script src="/assets/js/writing/mermaid-loader.js" type="module"></script>
{% endblock %}
