{% extends "layouts/base.njk" %}

{#- head：writing 子站使用自己的 partials/head.njk（字体、样式、SEO 子站版） -#}
{% block head %}
  {% include "writing/partials/head.njk" %}
{% endblock %}

{#- body class：writing 固定 header 同样需要预留高度（共享 base.css 用 .has-header 控制） -#}
{% block bodyAttrs %} class="has-header"{% endblock %}

{% block header %}{% include "writing/partials/site-header.njk" %}{% endblock %}

{% block footer %}{% include "writing/partials/site-footer.njk" %}{% endblock %}

{% block scripts %}<button type="button" class="back-to-top" aria-label="回到顶部">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 10.5V1.5M2 5.5L6 1.5 10 5.5"/></svg>
  </button>
  <script src="/assets/js/header-scroll.js" defer></script>
  <script src="/assets/js/writing/back-to-top.js" defer></script>
{% endblock %}
