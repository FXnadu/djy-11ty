<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#f5f5f0">

{#- 在首帧绘制前标记 JS 可用，CSS 据此默认隐藏动画元素，避免首帧闪现最终文案 -#}
<script>document.documentElement.classList.add('js');</script>
<title>{% if title and title != siteConfig.title %}{{ title }} - {{ siteConfig.title }}{% else %}{{ siteConfig.title }}{% endif %}</title>

{#- SEO / GEO 标签（OG、Canonical、JSON-LD 等）：seoConfig 注入站点级默认值 -#}
{%- set seoConfig = siteConfig -%}
{% include "partials/seo.njk" %}

{#- 字体与样式：CSS 直接并行加载（style.css 内的 @import 为串行阻塞，已移除）；本站无代码块，不引入 prism 主题 -#}
<link rel="preload" href="/assets/fonts/inter/inter-latin-200-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/fonts.css">
<link rel="stylesheet" href="/assets/css/base.css">
<link rel="stylesheet" href="/assets/css/shared.css">
<link rel="stylesheet" href="/assets/css/components.css">
<link rel="stylesheet" href="/assets/css/pages.css">

{#- 移动端层：必须排在所有桌面样式之后，按 base → shared → components → pages
    的顺序覆盖，优先级与桌面层一一对应 -#}
<link rel="stylesheet" href="/assets/css/mobile/base.css">
<link rel="stylesheet" href="/assets/css/mobile/shared.css">
<link rel="stylesheet" href="/assets/css/mobile/components.css">
<link rel="stylesheet" href="/assets/css/mobile/pages.css">
