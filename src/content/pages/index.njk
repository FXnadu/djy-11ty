---
permalink: /
showHeader: true
bodyClass: hero-intro
---

{% extends "layouts/base.njk" %}

{% block content %}
<section class="home-hero-split">
  <canvas class="ascii-bg is-hidden" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="split-left-content">
      <h1 class="hero-heading">dengjunyu</h1>
    </div>

  </div>
</section>

<section class="section">
  <div class="section-header">
    <h2>Make Me...</h2>
    <span class="t-meta">Contact</span>
  </div>
  <div class="contact-grid">
    {% for item in siteConfig.contacts %}
    <div class="contact-item">
      <span class="contact-label t-meta">{{ item.name }}</span>
      {% if item.url %}
      <a href="{{ item.url }}" class="contact-value">{{ item.value }}</a>
      {% else %}
      <span class="contact-value contact-copy" data-copy="{{ item.value }}">{{ item.value }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="section">
  <div class="section-header">
    <h2>Just Like Me</h2>
    <span class="t-meta">About</span>
  </div>
  <div class="about-content">
    <p class="about-text">{{ siteConfig.about }}</p>
  </div>
</section>

<script src="/assets/js/contact-copy.js" defer></script>
<script src="/assets/js/hero-decode.js" defer></script>
{#- 仅首页有 .ascii-bg canvas，故本站唯一的加载点 -#}
<script src="/assets/js/ascii-bg.js" defer></script>
{% endblock %}
